# Pooled Neon URL for normal server runtime queries.
NUXT_DATABASE_URL=postgresql://anai_app:replace-me@example-pooler.neon.tech/neondb?sslmode=require

# Direct Neon URL for migrations and administrative tooling only.
DATABASE_URL_UNPOOLED=postgresql://migration-role:replace-me@example.neon.tech/neondb?sslmode=require

# Private Brevo settings used only by the Nuxt server.
NUXT_BREVO_API_KEY=replace-me
NUXT_BREVO_SENDER_EMAIL=orders@example.com
NUXT_SALES_NOTIFICATION_EMAIL=sales@example.com
NUXT_SUPPORT_NOTIFICATION_EMAIL=support@example.com

# Private bearer token (at least 32 random characters) for scheduled recovery.
NUXT_RECOVERY_TOKEN=replace-with-a-long-random-token
# Set only to a single-IP header your ingress overwrites. Empty uses the socket IP.
# Never trust client-supplied X-Forwarded-For without ingress sanitization.
NUXT_TRUSTED_CLIENT_IP_HEADER=
